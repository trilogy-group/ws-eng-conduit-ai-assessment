{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Backend (Normal)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm start",
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "name": "Debug Backend (Breakpoints Working)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:debug"],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "restart": true,
      "protocol": "inspector",
      "autoAttachChildProcesses": true,
      "env": {
        "NODE_ENV": "development"
      }
    }
  ]
}
